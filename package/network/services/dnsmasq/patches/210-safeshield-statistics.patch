+static int safeshield_source_ignored(const union mysockaddr *source)
+{
+  if (!source)
+    return 1;
+
+  if (source->sa.sa_family == AF_INET)
+    return (ntohl(source->in.sin_addr.s_addr) & 0xff000000U) == 0x7f000000U;
+
+  if (source->sa.sa_family == AF_INET6)
+    return IN6_IS_ADDR_LOOPBACK(&source->in6.sin6_addr);
+
+  return 1;
+}
+
+static int safeshield_addr_equal(const struct safeshield_client_stat *stat,
+				    const union mysockaddr *source)
+{
+  if (!source || stat->family != source->sa.sa_family)
+    return 0;
+
+  if (stat->family == AF_INET)
+    return stat->addr.addr4.s_addr == source->in.sin_addr.s_addr;
+
+  if (stat->family == AF_INET6)
+    return memcmp(&stat->addr.addr6, &source->in6.sin6_addr, sizeof(struct in6_addr)) == 0;
+
+  return 0;
+}
+
+static struct safeshield_client_stat *safeshield_get_client(const union mysockaddr *source)
+{
+  unsigned int i;
+  struct safeshield_client_stat *stat;
+
+  if (!source || (source->sa.sa_family != AF_INET && source->sa.sa_family != AF_INET6))
+    return NULL;
+
+  for (i = 0; i < safeshield_client_count; i++)
+    if (safeshield_addr_equal(&safeshield_clients[i], source))
+      return &safeshield_clients[i];
+
+  if (safeshield_client_count >= SAFESHIELD_CLIENT_STATS_MAX)
+    return NULL;
+
+  stat = &safeshield_clients[safeshield_client_count++];
+  memset(stat, 0, sizeof(*stat));
+  stat->family = source->sa.sa_family;
+
+  if (stat->family == AF_INET)
+    stat->addr.addr4 = source->in.sin_addr;
+  else
+    stat->addr.addr6 = source->in6.sin6_addr;
+
+  return stat;
+}
+
+void safeshield_stats_apply_delta(const union mysockaddr *source, u64 queries, u64 blocked)
+{
+  struct safeshield_client_stat *stat;
+
+  if (safeshield_source_ignored(source))
+    return;
+
+  safeshield_queries += queries;
+  safeshield_blocked += blocked;
+
+  if (!(stat = safeshield_get_client(source)))
+    {
+      safeshield_untracked_queries += queries;
+      safeshield_untracked_blocked += blocked;
+      return;
+    }
+
+  stat->queries += queries;
+  stat->blocked += blocked;
+}
+
+static void safeshield_stats_send_delta(const union mysockaddr *source, u64 queries, u64 blocked)
+{
+  unsigned char op = PIPE_OP_SAFESHIELD_STATS;
+  struct safeshield_stats_delta delta;
+
+  memset(&delta, 0, sizeof(delta));
+  delta.source.sa.sa_family = source->sa.sa_family;
+
+  if (source->sa.sa_family == AF_INET)
+    delta.source.in.sin_addr = source->in.sin_addr;
+  else if (source->sa.sa_family == AF_INET6)
+    delta.source.in6.sin6_addr = source->in6.sin6_addr;
+  else
+    return;
+
+  delta.queries = queries;
+  delta.blocked = blocked;
+
+  read_write(daemon->pipe_to_parent, &op, sizeof(op), RW_WRITE);
+  read_write(daemon->pipe_to_parent, (unsigned char *)&delta, sizeof(delta), RW_WRITE);
+}
+
+static void safeshield_stats_record_delta(const union mysockaddr *source, u64 queries, u64 blocked)
+{
+  if (safeshield_source_ignored(source))
+    return;
+
+  if (daemon->pipe_to_parent != -1)
+    {
+      safeshield_stats_send_delta(source, queries, blocked);
+      return;
+    }
+
+  safeshield_stats_apply_delta(source, queries, blocked);
+}
+
+void safeshield_stats_record_query(const union mysockaddr *source)
+{
+  safeshield_stats_record_delta(source, 1, 0);
+}
+
+void safeshield_stats_record_blocked(const union mysockaddr *source)
+{
+  safeshield_stats_record_delta(source, 0, 1);
+}
+
+static int ubus_handle_safeshield_stats(struct ubus_context *ctx, struct ubus_object *obj,
+					 struct ubus_request_data *req, const char *method,
+					 struct blob_attr *msg)
+{
+  unsigned int i;
+  void *totals, *clients;
+
+  (void)obj;
+  (void)method;
+  (void)msg;
+
+  CHECK(blob_buf_init(&b, BLOBMSG_TYPE_TABLE));
+  CHECK(blobmsg_add_u32(&b, "schema", 1));
+  CHECK(blobmsg_add_string(&b, "instance_id", safeshield_instance_id));
+  CHECK(blobmsg_add_string(&b, "transport_scope", "udp+tcp"));
+  CHECK(blobmsg_add_u32(&b, "client_capacity", SAFESHIELD_CLIENT_STATS_MAX));
+  CHECK(blobmsg_add_u32(&b, "tracked_clients", safeshield_client_count));
+  CHECK(blobmsg_add_u64(&b, "untracked_queries", safeshield_untracked_queries));
+  CHECK(blobmsg_add_u64(&b, "untracked_blocked", safeshield_untracked_blocked));
+
+  totals = blobmsg_open_table(&b, "totals");
+  CHECK(blobmsg_add_u64(&b, "queries", safeshield_queries));
+  CHECK(blobmsg_add_u64(&b, "blocked", safeshield_blocked));
+  blobmsg_close_table(&b, totals);
+
+  clients = blobmsg_open_array(&b, "clients");
+  for (i = 0; i < safeshield_client_count; i++)
+    {
+      char addr[INET6_ADDRSTRLEN];
+      void *entry;
+      struct safeshield_client_stat *stat = &safeshield_clients[i];
+      const void *src;
+
+      src = stat->family == AF_INET ?
+	(const void *)&stat->addr.addr4 : (const void *)&stat->addr.addr6;
+
+      if (!inet_ntop(stat->family, src, addr, sizeof(addr)))
+	continue;
+
+      entry = blobmsg_open_table(&b, NULL);
+      CHECK(blobmsg_add_string(&b, "address", addr));
+      CHECK(blobmsg_add_u64(&b, "queries", stat->queries));
+      CHECK(blobmsg_add_u64(&b, "blocked", stat->blocked));
+      blobmsg_close_table(&b, entry);
+    }
+  blobmsg_close_array(&b, clients);
+
+  CHECK(ubus_send_reply(ctx, req, b.head));
+  return UBUS_STATUS_OK;
+}
+
 #ifdef HAVE_CONNTRACK
 static int ubus_handle_set_connmark_allowlist(struct ubus_context *ctx, struct ubus_object *obj,
